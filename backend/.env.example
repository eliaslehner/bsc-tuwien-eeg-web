# ============================================================
# Backend Pipeline Configuration Example
# ============================================================

# --- Input Data ---
BRAIN_NII_PATH= # e.g. ./data/nfbs/A00063008_NFB3_T1w_brain.nii
BRAIN_T1W_NII_PATH= # e.g. ./data/nfbs/A00063008_NFB3_T1w.nii
BRAIN_MASK_NII_PATH= # e.g. ./data/nfbs/A00063008_NFB3_T1w_brainmask.nii

# --- Export Directories ---
POINTCLOUD_EXPORT_DIR= # e.g. ./data/model/raw/pointcloud_exports
BRAINMAPPING_EXPORT_DIR= # e.g. ./data/model/mapped/brainmapping_exports
FRONTEND_DATA_DIR= # e.g. ./frontend/public/data

# --- Output Filenames ---
POINTCLOUD_PLY_FILENAME=brain_pointcloud.ply
MESH_PLY_FILENAME=brain_mesh.ply
MAPPED_MESH_PLY_FILENAME=brain_mesh_destrieux_mapped.ply
OUTPUT_JSON_FILENAME=region_metadata.json

# --- Point Cloud Generation Parameters ---
THRESHOLD=0.05
POSITION_NOISE=0.3
ALPHA=8.0
NORMAL_RADIUS=1.5
NORMAL_MAX_NN=50

# --- Marching Cubes Parameters ---
MC_LEVEL=0.15
MC_STEP_SIZE=1
MESH_TARGET_FACES=0 # Set to 0 for no simplification, otherwise target number of faces after simplification

# --- Device ---
# Options: auto, cpu, cuda, mps
DEVICE=auto

# --- Export Options ---
# Set to true to also copy mapped mesh PLY to FRONTEND_DATA_DIR (useful for testing)
COPY_MAPPED_MESH_TO_FRONTEND=true

# --- Viewer ---
# Set to true to launch the Open3D viewer after pipeline completes
SHOW_VIEWER=true

# --- EEG Channels (22-channel 10-20 system) ---
EEG_CHANNELS=Fz,FC3,FC1,FCz,FC2,FC4,C5,C3,C1,Cz,C2,C4,C6,CP3,CP1,CPz,CP2,CP4,P1,Pz,P2,POz

# --- EEG Processing ---
EEG_DATA_DIR=./data/eeg
EEG_SUBJECT=A03
EEG_SESSION=T
# Spatial reference: csd (surface Laplacian, default) or car (legacy)
EEG_REFERENCE=csd
EEG_EPOCH_TMIN=-0.5
EEG_EPOCH_TMAX=4.0
EEG_BASELINE_TMIN=-0.5
EEG_BASELINE_TMAX=0.0
EEG_DOWNSAMPLE_BINS=90
EEG_OUTPUT_FILENAME=eeg_data.json
